# Solo valores locales de ejemplo. Nunca subas secretos reales.
# Puerto del PostgreSQL levantado por scripts/dev-local.sh
DATABASE_URL=postgresql://postgres@127.0.0.1:55433/turismo_vinculacion_app
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3001
ADMIN_WEB_ORIGIN=http://localhost:3002
ROUTING_OSRM_CAR_URL=http://osrm-car:5000
ROUTING_OSRM_BICYCLE_URL=http://osrm-bicycle:5000
ROUTING_OSRM_FOOT_URL=http://osrm-foot:5000
ROUTING_REQUEST_TIMEOUT_MS=8000
AUTH_JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=turismo_refresh
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Agente IA (solo backend; selecciona un proveedor y modelo soportados por su cuenta).
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_STORAGE_ROOT=.data/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_UPLOAD_BYTES=52428800
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=turismo-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
