# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN corepack enable && corepack prepare pnpm@12.5.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY apps/api/package.json apps/api/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY apps/web/package.json apps/web/package.json

FROM base AS production-dependencies

RUN pnpm install --frozen-lockfile --filter @turismo/api... --prod

FROM base AS build

RUN pnpm install --frozen-lockfile --filter @turismo/api...

COPY apps/api apps/api

RUN pnpm --filter @turismo/api build

FROM production-dependencies AS runtime

ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=3000

COPY --from=build /app/apps/api/dist /app/apps/api/dist

RUN mkdir -p /app/.data/media \
  && chown node:node /app/.data /app/.data/media

USER node

EXPOSE 3000

CMD ["node", "apps/api/dist/main.js"]
