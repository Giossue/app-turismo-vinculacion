+- (void)handleTwoFingerDragGesture:(UIPanGestureRecognizer *)gesture {
+  if (!self.isPitchEnabled) return;
+
+  if (gesture.state == UIGestureRecognizerStateBegan) {
+    _threeFingerPitchInitial = self.camera.pitch;
+  }
+
+  if (gesture.state == UIGestureRecognizerStateBegan ||
+      gesture.state == UIGestureRecognizerStateChanged) {
+    if (gesture.numberOfTouches != 3) return;
+
+    CGPoint translation = [gesture translationInView:gesture.view];
+    if (fabs(translation.y) <= fabs(translation.x) * 1.2) return;
+
+    CGFloat pitch = _threeFingerPitchInitial - (translation.y / 2.0);
+    pitch = MAX(0.0, MIN(60.0, pitch));
+
+    MLNMapCamera *camera = [self.camera copy];
+    camera.pitch = pitch;
