{
  "expo": {
    "name": "Rumbo EC",
    "slug": "rumbo-ec",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rumbo-ec",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ec.edu.ueb.turismovinculacion.software"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#176B4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ec.edu.ueb.turismovinculacion.software",
      "versionCode": 4,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#176B4D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Permitir que Rumbo EC use tu ubicación durante una navegación activa, incluso al cambiar de aplicación.",
          "locationWhenInUsePermission": "Permitir que Rumbo EC use tu ubicación para mostrar tu posición en el mapa y calcular rutas."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      "./plugins/withAndroidBuildCleanups",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que Rumbo EC grabe tu pregunta de voz cuando actives el micrófono del agente."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo carga esta clase por reflexión desde el manifiesto.\n-keep class expo.modules.adapters.react.apploader.RNHeadlessAppLoader { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
